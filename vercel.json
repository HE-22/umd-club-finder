{
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,finder.html,about.html,styles.css,app.js}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
